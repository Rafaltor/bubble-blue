# BUBBLE-BLUE — copy to .env and edit (never commit .env)
#
# Minimal 2-node setup:
#   1. Same BUBBLE_BLUE_GROUP_KEY on every board
#   2. On EACH board: python3 config.py → note Local BD address
#   3. Each board's GROUP_MEMBERS = the OTHER boards only (never your own BD_ADDR)
#   4. Do NOT copy BUBBLE_BLUE_LOCAL_BD_ADDR between boards unless it matches hciconfig
#   5. Run: sudo python3 bb_node.py --chat
#
# Or use CLI instead of members: sudo python3 bb_node.py --chat --topology AA:BB:CC:DD:EE:02

# Shared group key (64 hex chars = 32 bytes). Generate once for the whole group:
#   python3 -c "import os; print(os.urandom(32).hex())"
BUBBLE_BLUE_GROUP_KEY=

# Peers this node should try to connect to (comma-separated BD_ADDR, uppercase optional).
# List only nodes that are powered on and in range — omit offline boards to avoid timeouts.
# Do not include your own address (it is ignored automatically).
# BUBBLE_BLUE_GROUP_MEMBERS=AA:BB:CC:DD:EE:02,AA:BB:CC:DD:EE:03

# Optional: same as --topology on the CLI (comma-separated allowlist + dial list)
# BUBBLE_BLUE_TOPOLOGY=AA:BB:CC:DD:EE:02

# Optional: single peer (same as bb_node.py --peer); prefer GROUP_MEMBERS or TOPOLOGY
# BUBBLE_BLUE_REMOTE_BD_ADDR=00:00:00:00:00:00

# Optional: Bluetooth interface (default hci0)
# BUBBLE_BLUE_INTERFACE=hci0

# Optional: override local BD_ADDR if hciconfig is unavailable
# BUBBLE_BLUE_LOCAL_BD_ADDR=AA:BB:CC:DD:EE:01
