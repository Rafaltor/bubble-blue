# BUBBLE-BLUE — copy to .env and edit (never commit .env)
#
# Open mesh (recommended):
#   1. Same BUBBLE_BLUE_GROUP_KEY on every board that should decrypt chat
#   2. BUBBLE_BLUE_TRANSPORT=ble_l2cap on every board
#   3. Leave GROUP_MEMBERS / TOPOLOGY unset — discovery via presence + auto-dial
#   4. Run: sudo python3.14 bb_node.py --chat
#
# Lab restriction (optional): list peers or use --topology AA:BB:CC:DD:EE:02

# Shared group key (64 hex chars = 32 bytes). Generate once for the whole group:
#   python3 -c "import os; print(os.urandom(32).hex())"
BUBBLE_BLUE_GROUP_KEY=

# Transport: ble_l2cap (LE CoC, Python 3.14+) or bt_classic
BUBBLE_BLUE_TRANSPORT=ble_l2cap

# --- Lab overrides (omit for open mesh) ---
# Peers to dial / allowlist (comma-separated BD_ADDR). Do not list your own address.
# BUBBLE_BLUE_GROUP_MEMBERS=AA:BB:CC:DD:EE:02,AA:BB:CC:DD:EE:03

# Same as --topology on the CLI
# BUBBLE_BLUE_TOPOLOGY=AA:BB:CC:DD:EE:02

# Optional single peer (same as bb_node.py --peer)
# BUBBLE_BLUE_REMOTE_BD_ADDR=00:00:00:00:00:00

# Optional chat aliases for /private rubikQ "message"
# BUBBLE_BLUE_CHAT_ALIASES=rubikQ=40:D9:5A:8B:69:3F,arduino=9C:B8:B4:9F:2D:75

# Optional: override local BD_ADDR if hciconfig is unavailable
# BUBBLE_BLUE_LOCAL_BD_ADDR=AA:BB:CC:DD:EE:01

# Optional HCI device (default hci0)
# BUBBLE_BLUE_INTERFACE=hci0
